generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(uuid())
  login           String         @unique
  password        String?
  points          BigInt         @default(0)
  unclaimedPoints BigInt         @default(0)
  level           Int            @default(1)
  passiveRate     Int            @default(0)
  nonce           Int            @default(0)
  energy          Int            @default(1000)
  maxEnergy       Int            @default(1000)
  exp             Int            @default(0)
  vipUntil        DateTime?
  skin            String?        @default("default")
  totalSpent      Float          @default(0) // Сумма реальных трат (TON/STARS)
  transactions    Transaction[]
  chatMessages    ChatMessage[]
  pointHistory    PointHistory[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([level])
  @@index([createdAt])
  // Убран дублирующий индекс по login, так как @unique уже создает его
}

model Transaction {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Float             // Для TON/STARS. Если POINTS, можно хранить эквивалент или использовать опциональные поля
  currency     CurrencyType
  status       TransactionStatus @default(PENDING)
  payload      String            @unique
  sku          String?
  itemName     String?
  applied      Boolean?          @default(false)
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  completedAt  DateTime?
  pointHistory PointHistory?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model PointHistory {
  id            String       @id @default(uuid()) // Изменено на uuid для консистентности
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        BigInt       @default(0)
  type          PointType    @default(PURCHASE)
  description   String
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

enum CurrencyType {
  TON
  STARS
  POINTS
}

enum TransactionStatus {
  PENDING
  SUCCESS   // Объединено (SUCCESS и COMPLETED теперь одна сущность)
  FAILED
  REFUNDED
}

enum PointType {
  PURCHASE
  DAILY_BONUS
  REFERRAL
  SYSTEM
  QUEST
  BONUS
}
