generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id
  points          BigInt         @default(0)
  unclaimedPoints BigInt         @default(0)
  level           Int            @default(1)
  passiveRate     Int            @default(0)
  nonce           Int            @default(0)
  energy          Int            @default(1000)
  maxEnergy       Int            @default(1000)
  exp             Int            @default(0)
  vipUntil        DateTime?
  skin            String?        @default("default")
  totalSpent      Float          @default(0)
  transactions    Transaction[]
  chatMessages    ChatMessage[]
  pointHistory    PointHistory[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([id])
  @@index([level])
  @@index([createdAt])
}

model Transaction {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  currency    CurrencyType
  status      TransactionStatus @default(PENDING)
  payload     String            @unique  
  sku         String?                    
  itemName    String?   
  applied     Boolean?  @default(false)                 
  metadata    Json?                       
  updatedAt   DateTime          @updatedAt
  completedAt DateTime?
  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([payload]) 
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model PointHistory {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        BigInt    @default(0)  // ✅ Изменено на BigInt
  type          PointType @default(PURCHASE)
  description   String
  transactionId String?   @unique
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

enum CurrencyType {
  TON
  STARS
  POINTS
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  COMPLETED  
}

enum PointType {
  PURCHASE
  DAILY_BONUS
  REFERRAL
  SYSTEM
  QUEST
  BONUS 
}